# Fonction globale disponible dans tous les scripts NPC.
function saluer(nom):
    return "Bonjour " + nom

on spawn:
    create variable visites (0) local
    set state "garde"
    set checkpoint "depart"
    play anime "idle"

on right click:
    if cooldown "salut" is ready:
        set "message" (call saluer("visiteur"))
        say local message
        emote "wave"
        set "visites" (visites + 1)
        set cooldown "salut" for 5 seconds

on right click while sneaking:
    say local "Tu as effectué une interaction spéciale."
    flag on (porte)

on entity approach:
    say local "Bienvenue près de moi !"

on npc approach:
    look at event npc

on player chat:
    if event message contains "bonjour":
        say local "Bonjour !"

on walk:
    if block below is stone:
        play sound "block.stone.step"

on interval:
    if flag (porte) is on:
        say local "La porte est ouverte."
